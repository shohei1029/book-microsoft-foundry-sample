dependencies
| where timestamp >= ago(1h)
| where cloud_RoleName == 'onboarding-agent'
| where name in (
    'invoke_agent rag_agent',
    'invoke_agent review_agent',
    'invoke_agent finalize_agent')
| summarize recordedSpans = count(),
    averageMs = avg(duration),
    p95Ms = percentile(duration, 95)
    by name, bin(timestamp, 5m)
| order by timestamp asc, name asc